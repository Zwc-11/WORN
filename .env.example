# Copy to .env (same folder). Read by server/ and pipeline/ only; the browser never sees it.
DECART_API_KEY=
API_PORT=8787
# Origins allowed to ask for a realtime token (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hard cap per realtime session, seconds. Realtime is billed per second ($0.02/s standard).
DECART_MAX_SESSION_S=900
